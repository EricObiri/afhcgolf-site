---
import { event } from '../data/event';
import { logo } from '../lib/media';

const links = [
  { href: '/tournament-information/', label: 'Tournament' },
  { href: '/sponsors/', label: 'Sponsorship' },
  { href: '/scholarship-program/', label: 'Programs' },
  { href: '/gallery/', label: 'Photos' },
  { href: '/leaderboard/', label: 'Leaderboard' },
  { href: '/contact-us/', label: 'Contact' },
];
const path = Astro.url.pathname;
const cta = event.status === 'open'
  ? { href: event.zeffyUrl, label: 'Register' }
  : { href: '/sponsors/', label: `Sponsor ${event.status === 'past' ? event.next.year : event.year}` };
---
<header class="hdr">
  <div class="wrap hdr__in">
    <a href="/" class="hdr__brand" aria-label="AFHC Golf Classic home">
      <img src={logo} alt="" width="150" height="60" />
      <span>AFHC Golf Classic</span>
    </a>
    <details class="hdr__menu">
      <summary aria-label="Menu">Menu</summary>
      <nav aria-label="Main">
        <ul>
          {links.map((l) => (
            <li><a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a></li>
          ))}
        </ul>
        <a class="btn hdr__cta" href={cta.href}>{cta.label}</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .hdr { background: var(--paper); border-bottom: 3px solid var(--black); position: sticky; top: 0; z-index: 5; }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4.5rem; }
  .hdr__brand { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; color: var(--black); }
  .hdr__brand img { height: 3rem; width: auto; background: var(--chalk); }
  .hdr__brand span { font: 400 var(--s1)/1 var(--display); }
  .hdr__menu summary { list-style: none; cursor: pointer; font: 400 var(--s1)/1 var(--display); padding: 0.6rem 0.9rem; border: 2px solid var(--black); }
  .hdr__menu summary::-webkit-details-marker { display: none; }
  .hdr__menu nav { position: absolute; left: 0; right: 0; top: 100%; background: var(--paper); border-bottom: 3px solid var(--black); padding: 1rem var(--gutter) 1.5rem; }
  .hdr__menu ul { list-style: none; margin: 0 0 1rem; padding: 0; }
  .hdr__menu li a { display: block; padding: 0.55rem 0; font: 400 var(--s2)/1.1 var(--display); color: var(--black); text-decoration: none; border-bottom: 1px solid var(--rule); }
  [aria-current='page'] { color: var(--gold-ink) !important; }

  @media (min-width: 960px) {
    .hdr__menu summary { display: none; }
    .hdr__menu nav { position: static; display: flex; align-items: center; gap: 1.5rem; padding: 0; border: 0; background: none; }
    .hdr__menu ul { display: flex; gap: 1.4rem; margin: 0; }
    .hdr__menu li a { font-size: var(--s1); border: 0; padding: 0.25rem 0; }
    .hdr__menu li a:hover { box-shadow: inset 0 -3px 0 var(--gold); }
    .hdr__cta { font-size: var(--s0); }
  }
</style>

<script>
  // Desktop: the <details> must always be open so the nav shows.
  const d = document.querySelector<HTMLDetailsElement>('.hdr__menu');
  const mq = window.matchMedia('(min-width: 960px)');
  const sync = () => { if (d) d.open = mq.matches; };
  sync(); mq.addEventListener('change', sync);
</script>
